APP_ENV=local
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
AUTO_MIGRATE=true

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=secunda
MYSQL_USER=secunda
MYSQL_PASSWORD=secunda
# Порты на хосте (внутри compose-сети используются стандартные 3306/6379/8080).
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
APP_HOST_PORT=8080
DB_DSN=secunda:secunda@tcp(mysql:3306)/secunda?parseTime=true&loc=UTC&charset=utf8mb4
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=5m

# Для локального запуска замените значение на длинную случайную строку.
JWT_SECRET=local-dev-secret-change-me-32-characters-minimum
JWT_TTL=24h

BCRYPT_COST=12
